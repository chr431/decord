+bool ThreadNameIsAv(DWORD tid) {
+    if (getenv("DECORD_AFF_V2_BYPASS")) return false;   // 二分：绕过按名识别
+    // FFmpeg 9 帧线程入口即 SetThreadDescription("av:<codec>:df<idx>"，
+    // pthread_frame.c thread_set_name)——按名识别，避免 v1 差分把 CUDA
+    // 初始化线程错钉进解码组（hevc 10fps 灾难根因）。
+    HANDLE h = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, tid);
+    if (!h) return false;
+    using Fn = HRESULT(WINAPI *)(HANDLE, PWSTR *);
+    static Fn get_desc = []() -> Fn {
+        HMODULE k = GetModuleHandleW(L"kernel32.dll");
+        return k ? reinterpret_cast<Fn>(GetProcAddress(k, "GetThreadDescription"))
+                 : nullptr;
+    }();
+    bool ok = false;
+    if (get_desc) {
+        PWSTR name = nullptr;
+        if (SUCCEEDED(get_desc(h, &name)) && name) {
+            ok = name[0] == L'a' && name[1] == L'v' && name[2] == L':';
+            LocalFree(name);
+        }
+    }
+    CloseHandle(h);
+    return ok;
